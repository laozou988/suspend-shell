<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="云枢悬浮屏"
        android:textColor="#132A4A"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="常驻悬浮屏，浮在剪映 / 抖音等任意应用上层\n随时展开取用「微云账」生成的内容：文案、分镜、字幕、提示词"
        android:textColor="#6B7A90"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="悬浮窗权限：未开启"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn"
        android:text="开启悬浮屏"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="首次使用：点击开启 → 授权「显示在其他应用上层」→ 自动启动悬浮屏\n编辑视频时呼出悬浮屏即可取用内容"
        android:textColor="#9AA7B8"
        android:textSize="13sp" />
</LinearLayout>
